<!-- src/views/admin/admin_edit.ejs -->
<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>แก้ไขผู้ดูแล | Admin</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-slate-50 text-slate-800 min-h-screen p-4 sm:p-8 flex items-center justify-center">

    <div class="max-w-md w-full bg-white rounded-2xl border border-slate-200 p-6 sm:p-8 shadow-sm">
        <div class="flex items-center justify-between pb-6 mb-6 border-b border-slate-100">
            <div>
                <h1 class="text-xl font-bold text-slate-900">แก้ไขผู้ดูแล #<%= admin.id %></h1>
                <p class="text-xs text-slate-500">ปรับปรุงข้อมูลบัญชีผู้ดูแลระบบ</p>
            </div>
            <a href="/admin/admins" class="text-xs text-slate-500 hover:text-slate-800">&larr; ยกเลิก</a>
        </div>

        <% if (error) { %>
            <div class="mb-4 p-3 bg-red-50 border border-red-200 text-red-600 text-xs rounded-xl text-center">
                <%= error %>
            </div>
        <% } %>

        <form action="/admin/admins/<%= admin.id %>/edit" method="POST" class="space-y-4 text-sm">
            <div>
                <label class="block text-xs font-semibold text-slate-700 mb-1">ชื่อผู้ใช้ (Username) *</label>
                <input type="text" name="username" required value="<%= admin.username %>"
                       class="w-full px-3.5 py-2.5 rounded-xl border border-slate-200 focus:outline-none focus:ring-2 focus:ring-indigo-500">
            </div>

            <div>
                <label class="block text-xs font-semibold text-slate-700 mb-1">รหัสผ่านใหม่ (เว้นว่างไว้ถ้าไม่ต้องการเปลี่ยน)</label>
                <input type="password" name="password" placeholder="••••••••"
                       class="w-full px-3.5 py-2.5 rounded-xl border border-slate-200 focus:outline-none focus:ring-2 focus:ring-indigo-500">
            </div>

            <div class="flex items-center justify-end gap-3 pt-4 border-t border-slate-100">
                <a href="/admin/admins" class="px-4 py-2 rounded-xl text-slate-600 hover:bg-slate-100 text-xs font-medium">ยกเลิก</a>
                <button type="submit" class="px-5 py-2.5 rounded-xl bg-indigo-600 text-white font-medium hover:bg-indigo-700 transition text-xs sm:text-sm">
                    บันทึกการเปลี่ยนแปลง
                </button>
            </div>
        </form>
    </div>

</body>
</html>
