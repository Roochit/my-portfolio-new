<!-- src/views/product-back/product_edit.ejs -->
<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>แก้ไขผลงาน (Product) | Admin</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-slate-50 text-slate-800 min-h-screen p-4 sm:p-8">

    <div class="max-w-2xl mx-auto bg-white rounded-2xl border border-slate-200 p-6 sm:p-8 shadow-sm">
        <div class="flex items-center justify-between pb-6 mb-6 border-b border-slate-100">
            <div>
                <h1 class="text-xl font-bold text-slate-900">แก้ไขผลงาน #<%= project.id %></h1>
                <p class="text-xs text-slate-500">ปรับปรุงข้อมูลผลงาน หรือดึงรูปปกใหม่จาก YouTube</p>
            </div>
            <a href="/admin/products" class="text-xs text-slate-500 hover:text-slate-800">&larr; ยกเลิก</a>
        </div>

        <form action="/admin/products/<%= project.id %>/edit" method="POST" class="space-y-4 text-sm">
            <div>
                <label class="block text-xs font-semibold text-slate-700 mb-1">ชื่อผลงาน (Title) *</label>
                <input type="text" name="title" required value="<%= project.title %>"
                       class="w-full px-3.5 py-2.5 rounded-xl border border-slate-200 focus:outline-none focus:ring-2 focus:ring-indigo-500">
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div>
                    <label class="block text-xs font-semibold text-slate-700 mb-1">หมวดหมู่ (Category) *</label>
                    <select name="category" required class="w-full px-3.5 py-2.5 rounded-xl border border-slate-200 focus:outline-none focus:ring-2 focus:ring-indigo-500 bg-white">
                        <option value="animation" <%= project.category === 'animation' ? 'selected' : '' %>>🎬 Animation</option>
                        <option value="game" <%= project.category === 'game' ? 'selected' : '' %>>🎮 Game</option>
                        <option value="webapp" <%= project.category === 'webapp' ? 'selected' : '' %>>💻 Web App</option>
                    </select>
                </div>
                <div>
                    <label class="block text-xs font-semibold text-slate-700 mb-1">Tags (คั่นด้วยจุลภาค ,)</label>
                    <input type="text" name="tags" value="<%= (project.tags || []).join(', ') %>"
                       class="w-full px-3.5 py-2.5 rounded-xl border border-slate-200 focus:outline-none focus:ring-2 focus:ring-indigo-500">
                </div>
            </div>

            <!-- YouTube Video URL with Auto Thumbnail extraction -->
            <div>
                <label class="block text-xs font-semibold text-slate-700 mb-1">ลิงก์วิดีโอ (YouTube URL)</label>
                <div class="flex gap-2">
                    <input type="url" id="videoUrl" name="videoUrl" value="<%= project.videoUrl || '' %>" placeholder="https://youtu.be/... หรือ https://www.youtube.com/watch?v=..."
                           class="flex-1 px-3.5 py-2.5 rounded-xl border border-slate-200 focus:outline-none focus:ring-2 focus:ring-indigo-500">
                    <button type="button" id="btnFetchYt" class="px-4 py-2.5 rounded-xl bg-red-50 text-red-600 hover:bg-red-100 font-semibold text-xs transition flex items-center gap-1.5 whitespace-nowrap">
                        <span>🎬</span> ดึงรูปจาก YouTube
                    </button>
                </div>
                <p class="text-[11px] text-slate-400 mt-1">* คลิกปุ่มเพื่อดึงรูปล่าสุดจาก YouTube มาใส่ในช่อง Thumbnail ทันที</p>
            </div>

            <!-- Image Thumbnail & Live Preview -->
            <div>
                <label class="block text-xs font-semibold text-slate-700 mb-1">รูปภาพ Thumbnail (URL หรือ Path)</label>
                <% 
                    const currentCover = project.coverImage || project.image || '';
                %>
                <div class="flex gap-4 items-start">
                    <div class="flex-1">
                        <input type="text" id="imageInput" name="image" value="<%= currentCover %>" placeholder="https://img.youtube.com/vi/... หรือ assets/..."
                               class="w-full px-3.5 py-2.5 rounded-xl border border-slate-200 focus:outline-none focus:ring-2 focus:ring-indigo-500">
                    </div>
                    <div class="w-24 h-16 rounded-xl border border-slate-200 bg-slate-50 overflow-hidden flex items-center justify-center shrink-0">
                        <img id="thumbPreview" src="<%= currentCover %>" alt="Preview" class="w-full h-full object-cover <%= currentCover ? '' : 'hidden' %>">
                        <span id="thumbPlaceholder" class="text-xs text-slate-400 <%= currentCover ? 'hidden' : '' %>">รูปตัวอย่าง</span>
                    </div>
                </div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div>
                    <label class="block text-xs font-semibold text-slate-700 mb-1">ลิงก์ดาวน์โหลด / Demo</label>
                    <input type="url" name="downloadUrl" value="<%= project.downloadUrl || '' %>" placeholder="https://itch.io/..."
                           class="w-full px-3.5 py-2.5 rounded-xl border border-slate-200 focus:outline-none focus:ring-2 focus:ring-indigo-500">
                </div>
                <div>
                    <label class="block text-xs font-semibold text-slate-700 mb-1">ลิงก์เอกสาร / GitHub</label>
                    <input type="url" name="docUrl" value="<%= project.docUrl || '' %>" placeholder="https://github.com/..."
                           class="w-full px-3.5 py-2.5 rounded-xl border border-slate-200 focus:outline-none focus:ring-2 focus:ring-indigo-500">
                </div>
            </div>

            <div>
                <label class="block text-xs font-semibold text-slate-700 mb-1">คำอธิบาย (Description)</label>
                <textarea name="description" rows="4"
                          class="w-full px-3.5 py-2.5 rounded-xl border border-slate-200 focus:outline-none focus:ring-2 focus:ring-indigo-500"><%= project.description || '' %></textarea>
            </div>

            <div class="flex items-center justify-end gap-3 pt-4 border-t border-slate-100">
                <a href="/admin/products" class="px-4 py-2 rounded-xl text-slate-600 hover:bg-slate-100 text-xs font-medium">ยกเลิก</a>
                <button type="submit" class="px-5 py-2.5 rounded-xl bg-indigo-600 text-white font-medium hover:bg-indigo-700 transition text-xs sm:text-sm">
                    บันทึกการเปลี่ยนแปลง
                </button>
            </div>
        </form>
    </div>

    <!-- YouTube Thumbnail Extraction Script -->
    <script>
        const videoInput = document.getElementById('videoUrl');
        const imageInput = document.getElementById('imageInput');
        const btnFetchYt = document.getElementById('btnFetchYt');
        const thumbPreview = document.getElementById('thumbPreview');
        const thumbPlaceholder = document.getElementById('thumbPlaceholder');

        function updatePreview(url) {
            if (url && (url.startsWith('http') || url.startsWith('/'))) {
                thumbPreview.src = url;
                thumbPreview.classList.remove('hidden');
                thumbPlaceholder.classList.add('hidden');
            } else {
                thumbPreview.src = '';
                thumbPreview.classList.add('hidden');
                thumbPlaceholder.classList.remove('hidden');
            }
        }

        function extractYouTubeId(url) {
            if (!url) return null;
            const regExp = /(?:youtu\.be\/|youtube\.com\/(?:embed\/|v\/|watch\?v=|watch\?.+&v=|video\/))([\w-]{11})/;
            const match = url.match(regExp);
            return match ? match[1] : null;
        }

        function fetchYouTubeThumbnail() {
            const ytId = extractYouTubeId(videoInput.value.trim());
            if (ytId) {
                const thumbUrl = `https://img.youtube.com/vi/${ytId}/hqdefault.jpg`;
                imageInput.value = thumbUrl;
                updatePreview(thumbUrl);
            } else {
                alert('ไม่พบ Video ID ของ YouTube จากลิงก์ที่กรอก');
            }
        }

        btnFetchYt.addEventListener('click', fetchYouTubeThumbnail);
        imageInput.addEventListener('input', () => updatePreview(imageInput.value.trim()));
    </script>

</body>
</html>
