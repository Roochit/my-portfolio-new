<!-- src/views/project-font/project_detail.ejs -->
<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-slate-50 text-slate-800 min-h-screen flex flex-col">

    <!-- Header -->
    <header class="bg-white border-b border-slate-200">
        <div class="max-w-4xl mx-auto px-4 h-16 flex items-center justify-between">
            <a href="/" class="text-sm font-medium text-slate-600 hover:text-indigo-600 flex items-center gap-1">
                &larr; กลับหน้ารวมผลงาน
            </a>
            <span class="text-xs px-2.5 py-1 rounded-full bg-slate-100 text-slate-700 font-semibold uppercase">
                <%= project.category %>
            </span>
        </div>
    </header>

    <!-- Main Content -->
    <main class="max-w-4xl mx-auto px-4 py-8 flex-1 w-full">
        <article class="bg-white rounded-2xl border border-slate-200 p-6 sm:p-8 shadow-sm">
            
            <h1 class="text-2xl sm:text-3xl font-extrabold text-slate-900 mb-4">
                <%= project.title %>
            </h1>

            <!-- Tags -->
            <% if (project.tags && project.tags.length > 0) { %>
                <div class="flex flex-wrap gap-2 mb-6">
                    <% project.tags.forEach(tag => { %>
                        <span class="px-3 py-1 rounded-lg bg-indigo-50 text-indigo-700 text-xs font-medium">#<%= tag %></span>
                    <% }) %>
                </div>
            <% } %>

            <!-- Video or Image Presentation -->
            <% 
                let youtubeEmbed = '';
                if (project.videoUrl) {
                    const ytMatch = project.videoUrl.match(/(?:youtu\.be\/|youtube\.com\/(?:embed\/|v\/|watch\?v=|watch\?.+&v=|video\/))([\w-]{11})/);
                    if (ytMatch) youtubeEmbed = `https://www.youtube.com/embed/${ytMatch[1]}`;
                }
                const cover = project.coverImage || project.image || '';
                const imgSrc = cover.startsWith('http') ? cover : (cover ? '/' + cover : '');
            %>

            <div class="mb-6 rounded-xl overflow-hidden bg-slate-900 border border-slate-200 shadow-inner">
                <% if (youtubeEmbed) { %>
                    <div class="aspect-video w-full">
                        <iframe src="<%= youtubeEmbed %>" class="w-full h-full" frameborder="0" allowfullscreen allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"></iframe>
                    </div>
                <% } else if (imgSrc) { %>
                    <img src="<%= imgSrc %>" alt="<%= project.title %>" class="w-full max-h-[480px] object-cover" onerror="this.onerror=null; this.parentElement.innerHTML='<div class=\'py-20 text-center text-slate-400\'>🎨 ไม่มีรูปตัวอย่าง</div>';">
                <% } else { %>
                    <div class="py-20 text-center text-slate-400">🎨 ไม่มีรูปภาพหรือวิดีโอ</div>
                <% } %>
            </div>

            <!-- Description -->
            <div class="prose max-w-none text-slate-700 mb-8 text-sm sm:text-base leading-relaxed whitespace-pre-line">
                <%= project.description || 'ไม่มีคำอธิบายเพิ่มเติม' %>
            </div>

            <!-- Action Links -->
            <div class="flex flex-wrap gap-3 pt-6 border-t border-slate-100">
                <% if (project.downloadUrl) { %>
                    <a href="<%= project.downloadUrl %>" target="_blank" rel="noopener" class="px-5 py-2.5 rounded-xl bg-indigo-600 text-white font-medium text-sm hover:bg-indigo-700 transition flex items-center gap-2">
                        🎮 เล่นเกม / ดาวน์โหลด
                    </a>
                <% } %>

                <% if (project.videoUrl) { %>
                    <a href="<%= project.videoUrl %>" target="_blank" rel="noopener" class="px-5 py-2.5 rounded-xl bg-red-600 text-white font-medium text-sm hover:bg-red-700 transition flex items-center gap-2">
                        ▶ ดูบน YouTube
                    </a>
                <% } %>

                <% if (project.docUrl) { %>
                    <a href="<%= project.docUrl %>" target="_blank" rel="noopener" class="px-5 py-2.5 rounded-xl bg-slate-900 text-white font-medium text-sm hover:bg-slate-800 transition flex items-center gap-2">
                        📄 Source Code / เอกสาร
                    </a>
                <% } %>
            </div>

        </article>
    </main>

    <!-- Footer -->
    <footer class="bg-white border-t border-slate-200 py-6 text-center text-xs text-slate-500">
        © 2026 Roochit Khamcharoen • Portfolio
    </footer>

</body>
</html>
